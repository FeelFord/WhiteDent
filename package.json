{
  "name": "whitedent",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "build": "next build",
    "start": "next start --hostname 0.0.0.0",
    "typecheck": "next typegen && tsc --noEmit",
    "test:e2e": "playwright test",
    "test:quality": "playwright test tests/e2e/quality.spec.ts",
    "build:pages": "node scripts/build-pages.mjs",
    "preview:pages": "node scripts/serve-pages.mjs",
    "test:pages": "playwright test --config=playwright.pages.config.ts",
    "deploy:pages": "node scripts/publish-pages.mjs"
  },
  "engines": {
    "node": ">=22 <25"
  },
  "dependencies": {
    "lucide-react": "1.70.0",
    "motion": "14.10.1",
    "next": "16.4.5",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.65.0",
    "@tailwindcss/postcss": "4.3.5",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "tailwindcss": "4.3.5",
    "typescript": "5.9.3"
  }
}
